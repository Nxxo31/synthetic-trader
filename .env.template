# .env template for Synthetic Trader
# Copy this to .env and fill in your values

# Deriv API (required for paper/live trading)
DERIV_API_TOKEN=pat_xxxxxxxxxxxxxxxxxx  # Your Personal Access Token
DERIV_APP_ID=12345                       # Your App ID (alphanumeric, e.g., 33Y5EmAQJgXagwIUJQ8Vw)

# Telegram notifications (optional but recommended for daily reports)
# Get these from @BotFather and your chat ID
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Trading parameters (optional overrides)
# DEFAULT_SYMBOL=RB100
# MAX_TRADES_PER_DAY=30
# SCORE_THRESHOLD=0.50
# MAX_RISK_PER_TRADE=0.03